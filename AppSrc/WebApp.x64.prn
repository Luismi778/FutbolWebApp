37596>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37599>>>>>>>        Case Begin
37599>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37601>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37601>>>>>>>                Case Break
37602>>>>>>>
37602>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37605>>>>>>>                // If from parent, this is a constrained drill down.
37605>>>>>>>                Case Break
37606>>>>>>>
37606>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37609>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37609>>>>>>>                Case Break
37610>>>>>>>
37610>>>>>>>            Case Else // must be nfUndefined
37610>>>>>>>
37610>>>>>>>        Case End
37610>>>>>>>
37610>>>>>>>        Send SetActionButtons
37611>>>>>>>
37611>>>>>>>    End_Procedure
