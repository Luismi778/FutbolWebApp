38099>>>    Procedure UpdateViewCaption
38102>>>        Boolean bHasRecord
38102>>>        String sNombre
38102>>>
38102>>>        Get HasRecord of ojugador_DD to bHasRecord
38103>>>        Move (Trim(jugador.Nombre)) to sNombre
38104>>>
38104>>>        If (sNombre = "" and bHasRecord) Begin
38106>>>            Get Field_Current_Value of ojugador_DD Field jugador.Nombre to sNombre
38107>>>            Move (Trim(sNombre)) to sNombre
38108>>>        End
38108>>>>
38108>>>
38108>>>        If (sNombre <> "") Begin
38110>>>            WebSet psCaption to ("Jugador: " + sNombre)
38111>>>        End
38111>>>>
38111>>>        Else If (bHasRecord) Begin
38114>>>            WebSet psCaption to "Jugador"
38115>>>        End
38115>>>>
38115>>>        Else Begin
38116>>>            WebSet psCaption to "Nuevo jugador"
38117>>>        End
38117>>>>
