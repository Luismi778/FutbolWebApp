39048>>>        WebSet pbRender of oNewButton to True
39049>>>        WebSet pbRender of oDetailButton to True
39050>>>
39050>>>        Case Begin
39050>>>            Case (NavigateData.eNavigateType = nfFromParent)
39052>>>                // If from parent, this is a constrained drill down
39052>>>                Case Break
39053>>>
39053>>>            Case (NavigateData.eNavigateType = nfFromChild)
39056>>>                // If from child, this is a probably a parent lookup from a Zoom
39056>>>                Case Break
39057>>>
39057>>>            Case (NavigateData.eNavigateType = nfFromMain)
39060>>>                // If from main, this is a probably a main-file lookup from a Zoom
39060>>>                WebSet pbRender of oDetailButton to False
39061>>>                Case Break
39062>>>
39062>>>            Case Else // must be nfUndefined
39062>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39062>>>
39062>>>        Case End
39062>>>
39062>>>    End_Procedure
