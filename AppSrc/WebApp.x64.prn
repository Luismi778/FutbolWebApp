38661>>>    Function WebCrumb_Caption Returns String
38664>>>        String sNombre sApellido
38664>>>        Boolean bHasRecord
38664>>>
38664>>>        Get HasRecord of oentrenador_DD to bHasRecord
38665>>>
38665>>>        If (bHasRecord or entrenador.ID > 0) Begin
38667>>>            Get Field_Current_Value of oentrenador_DD Field entrenador.Nombre to sNombre
38668>>>            Move (Trim(sNombre)) to sNombre
38669>>>
38669>>>            If (sNombre = "") Begin
38671>>>                Move (Trim(entrenador.Nombre)) to sNombre
38672>>>            End
38672>>>>
38672>>>
38672>>>            Get Field_Current_Value of oentrenador_DD Field entrenador.Apellido to sApellido
38673>>>            Move (Trim(sApellido)) to sApellido
38674>>>
38674>>>            If (sApellido = "") Begin
38676>>>                Move (Trim(entrenador.Apellido)) to sApellido
38677>>>            End
38677>>>>
38677>>>
38677>>>            If (sNombre <> "" and sApellido <> "") Begin
38679>>>                Function_Return ("Entrenador: " + sNombre + " " + sApellido)
38680>>>            End
38680>>>>
38680>>>            Else If (sNombre <> "") Begin
38683>>>                Function_Return ("Entrenador: " + sNombre)
38684>>>            End
38684>>>>
38684>>>            Else Begin
38685>>>                Function_Return "Entrenador"
38686>>>            End
38686>>>>
38686>>>        End
38686>>>>
38686>>>
38686>>>        Function_Return "Nuevo entrenador"
38687>>>    End_Function
