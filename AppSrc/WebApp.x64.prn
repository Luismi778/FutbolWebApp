36718>>>>>>>        Move (MemCopy(AddressOf(ucaBuffer), pBase64, iLen)) to iLen
36719>>>>>>>        Move (Free(pBase64)) to iLen
36720>>>>>>>        Function_Return ucaBuffer
36721>>>>>>>    End_Function
