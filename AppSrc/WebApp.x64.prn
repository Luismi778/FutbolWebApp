37551>>>>>>>    Procedure SetActionButtons
37554>>>>>>>        tWebNavigateData NavigateData
37554>>>>>>>        tWebNavigateData NavigateData
37554>>>>>>>        Boolean bHasRecord
37554>>>>>>>        Handle hoDD
37554>>>>>>>
37554>>>>>>>        Get Server to hoDD
37555>>>>>>>        Get GetNavigateData to NavigateData
37556>>>>>>>        Get HasRecord of hoDD to bHasRecord
37557>>>>>>>
37557>>>>>>>        // let's hide all buttons and then Show the ones we want
37557>>>>>>>        WebSet pbRender of oEditBtn to False
37558>>>>>>>        WebSet pbRender of oSaveBtn to False
37559>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37560>>>>>>>        WebSet pbRender of oDeleteBtn to False
37561>>>>>>>
37561>>>>>>>        If (NavigateData.bReadOnly) Begin
37563>>>>>>>            WebSet pbRender of oEditBtn to True
37564>>>>>>>        End
37564>>>>>>>>
37564>>>>>>>        Else Begin
37565>>>>>>>            WebSet pbRender of oSaveBtn to True
37566>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37567>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37568>>>>>>>        End
37568>>>>>>>>
37568>>>>>>>    End_Procedure
