37568>>>>>>>    Procedure SetActionButtons
37571>>>>>>>        tWebNavigateData NavigateData
37571>>>>>>>        tWebNavigateData NavigateData
37571>>>>>>>        Boolean bHasRecord
37571>>>>>>>        Handle hoDD
37571>>>>>>>
37571>>>>>>>        Get Server to hoDD
37572>>>>>>>        Get GetNavigateData to NavigateData
37573>>>>>>>        Get HasRecord of hoDD to bHasRecord
37574>>>>>>>
37574>>>>>>>        // let's hide all buttons and then Show the ones we want
37574>>>>>>>        WebSet pbRender of oEditBtn to False
37575>>>>>>>        WebSet pbRender of oSaveBtn to False
37576>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37577>>>>>>>        WebSet pbRender of oDeleteBtn to False
37578>>>>>>>
37578>>>>>>>        If (NavigateData.bReadOnly) Begin
37580>>>>>>>            WebSet pbRender of oEditBtn to True
37581>>>>>>>        End
37581>>>>>>>>
37581>>>>>>>        Else Begin
37582>>>>>>>            WebSet pbRender of oSaveBtn to True
37583>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37584>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37585>>>>>>>        End
37585>>>>>>>>
37585>>>>>>>    End_Procedure
