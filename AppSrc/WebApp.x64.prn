37579>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37582>>>>>>>        Case Begin
37582>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37584>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37584>>>>>>>                Case Break
37585>>>>>>>
37585>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37588>>>>>>>                // If from parent, this is a constrained drill down.
37588>>>>>>>                Case Break
37589>>>>>>>
37589>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37592>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37592>>>>>>>                Case Break
37593>>>>>>>
37593>>>>>>>            Case Else // must be nfUndefined
37593>>>>>>>
37593>>>>>>>        Case End
37593>>>>>>>
37593>>>>>>>        Send SetActionButtons
37594>>>>>>>
37594>>>>>>>    End_Procedure
37595>>>>>>>
37595>>>>>>>End_Object 
