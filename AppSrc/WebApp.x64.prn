38633>>>    Function NavigateCaption Returns String
38636>>>        String sNombre
38636>>>        Boolean bHasRecord
38636>>>
38636>>>        Get HasRecord of oentrenador_DD to bHasRecord
38637>>>        Move (Trim(entrenador.Nombre)) to sNombre
38638>>>
38638>>>        If (sNombre = "" and bHasRecord) Begin
38640>>>            Get Field_Current_Value of oentrenador_DD Field entrenador.Nombre to sNombre
38641>>>            Move (Trim(sNombre)) to sNombre
38642>>>        End
38642>>>>
38642>>>
38642>>>        If (sNombre <> "") Begin
38644>>>            Function_Return ("Entrenador: " + sNombre)
38645>>>        End
38645>>>>
38645>>>        Else If (bHasRecord or entrenador.ID > 0) Begin
38648>>>            Function_Return "Entrenador"
38649>>>        End
38649>>>>
38649>>>
38649>>>        Function_Return "Nuevo entrenador"
38650>>>    End_Function
