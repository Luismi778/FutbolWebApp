38112>>>    Function WebCrumb_Caption Returns String
38115>>>        Boolean bHasRecord
38115>>>        String sNombre sApellido
38115>>>
38115>>>        Get HasRecord of ojugador_DD to bHasRecord
38116>>>
38116>>>        If (bHasRecord or jugador.ID > 0) Begin
38118>>>            Get Field_Current_Value of ojugador_DD Field jugador.Nombre to sNombre
38119>>>            Move (Trim(sNombre)) to sNombre
38120>>>
38120>>>            If (sNombre = "") Begin
38122>>>                Move (Trim(jugador.Nombre)) to sNombre
38123>>>            End
38123>>>>
38123>>>
38123>>>            Get Field_Current_Value of ojugador_DD Field jugador.Apellido to sApellido
38124>>>            Move (Trim(sApellido)) to sApellido
38125>>>
38125>>>            If (sApellido = "") Begin
38127>>>                Move (Trim(jugador.Apellido)) to sApellido
38128>>>            End
38128>>>>
38128>>>
38128>>>            If (sNombre <> "" and sApellido <> "") Begin
38130>>>                Function_Return ("Jugador: " + sNombre + " " + sApellido)
38131>>>            End
38131>>>>
38131>>>            Else If (sNombre <> "") Begin
38134>>>                Function_Return ("Jugador: " + sNombre)
38135>>>            End
38135>>>>
38135>>>            Else Begin
38136>>>                Function_Return "Jugador"
38137>>>            End
38137>>>>
38137>>>        End
38137>>>>
38137>>>
38137>>>        Function_Return "Nuevo jugador"
38138>>>    End_Function
38139>>>
