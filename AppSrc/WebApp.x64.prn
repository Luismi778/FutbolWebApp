37581>>>>>>>        Else Begin
37582>>>>>>>            WebSet pbRender of oSaveBtn to True
37583>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37584>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37585>>>>>>>        End
