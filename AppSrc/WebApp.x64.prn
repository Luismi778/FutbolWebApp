38644>>>    Function WebCrumb_Caption Returns String
38647>>>        String sNombre sApellido
38647>>>        Boolean bHasRecord
38647>>>
38647>>>        Get HasRecord of oentrenador_DD to bHasRecord
38648>>>
38648>>>        If (bHasRecord or entrenador.ID > 0) Begin
38650>>>            Get Field_Current_Value of oentrenador_DD Field entrenador.Nombre to sNombre
38651>>>            Move (Trim(sNombre)) to sNombre
38652>>>
38652>>>            If (sNombre = "") Begin
38654>>>                Move (Trim(entrenador.Nombre)) to sNombre
38655>>>            End
38655>>>>
38655>>>
38655>>>            Get Field_Current_Value of oentrenador_DD Field entrenador.Apellido to sApellido
38656>>>            Move (Trim(sApellido)) to sApellido
38657>>>
38657>>>            If (sApellido = "") Begin
38659>>>                Move (Trim(entrenador.Apellido)) to sApellido
38660>>>            End
38660>>>>
38660>>>
38660>>>            If (sNombre <> "" and sApellido <> "") Begin
38662>>>                Function_Return ("Entrenador: " + sNombre + " " + sApellido)
38663>>>            End
38663>>>>
38663>>>            Else If (sNombre <> "") Begin
38666>>>                Function_Return ("Entrenador: " + sNombre)
38667>>>            End
38667>>>>
38667>>>            Else Begin
38668>>>                Function_Return "Entrenador"
38669>>>            End
38669>>>>
38669>>>        End
38669>>>>
38669>>>
38669>>>        Function_Return "Nuevo entrenador"
38670>>>    End_Function
