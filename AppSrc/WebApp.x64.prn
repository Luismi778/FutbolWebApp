38095>>>    Function WebCrumb_Caption Returns String
38098>>>        Boolean bHasRecord
38098>>>        String sNombre sApellido
38098>>>
38098>>>        Get HasRecord of ojugador_DD to bHasRecord
38099>>>
38099>>>        If (bHasRecord or jugador.ID > 0) Begin
38101>>>            Get Field_Current_Value of ojugador_DD Field jugador.Nombre to sNombre
38102>>>            Move (Trim(sNombre)) to sNombre
38103>>>
38103>>>            If (sNombre = "") Begin
38105>>>                Move (Trim(jugador.Nombre)) to sNombre
38106>>>            End
38106>>>>
38106>>>
38106>>>            Get Field_Current_Value of ojugador_DD Field jugador.Apellido to sApellido
38107>>>            Move (Trim(sApellido)) to sApellido
38108>>>
38108>>>            If (sApellido = "") Begin
38110>>>                Move (Trim(jugador.Apellido)) to sApellido
38111>>>            End
38111>>>>
38111>>>
38111>>>            If (sNombre <> "" and sApellido <> "") Begin
38113>>>                Function_Return ("Jugador: " + sNombre + " " + sApellido)
38114>>>            End
38114>>>>
38114>>>            Else If (sNombre <> "") Begin
38117>>>                Function_Return ("Jugador: " + sNombre)
38118>>>            End
38118>>>>
38118>>>            Else Begin
38119>>>                Function_Return "Jugador"
38120>>>            End
38120>>>>
38120>>>        End
38120>>>>
38120>>>
38120>>>        Function_Return "Nuevo jugador"
38121>>>    End_Function
38122>>>
