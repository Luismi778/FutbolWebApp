// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomJugador.wo
// ZoomJugador
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebButton.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cjugadorposicionDataDictionary.dd
Use cposicionDataDictionary.dd
Register_Object oSelectEquipo
Register_Object oSelectPosicion

Object oZoomJugador is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Nuevo jugador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Register_Procedure UpdateViewCaption
    Register_Procedure UpdatePosicionJugador

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server to oequipo_DD

        Procedure OnPostFind Integer eMessage Boolean bFound
            Forward Send OnPostFind eMessage bFound
            Delegate Send UpdateViewCaption
            Delegate Send UpdatePosicionJugador
        End_Procedure
    End_Object 

    Object oposicion_DD is a cposicionDataDictionary
    End_Object

    Object ojugadorposicion_DD is a cjugadorposicionDataDictionary
        Set DDO_Server to ojugador_DD
        Set DDO_Server to oposicion_DD
    End_Object 

    Set Main_DD to ojugador_DD
    Set Server  to ojugador_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4
        
        Object oPosicionesBtn is a cWebButton
            Set psCaption to "Posiciones"
            Set piColumnSpan to 4
            Set piColumnIndex to 0

            WebRegisterPath ntNavigateForward oSelectPosicion

            Procedure OnClick
                Send NavigatePath
            End_Procedure
        End_Object

        Object ojugadorNombre is a cWebForm
            Entry_Item jugador.Nombre
            Set piColumnSpan to 6
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
            Set psCSSClass to "CampoBlanco"
        End_Object 

        Object ojugadorApellido is a cWebForm
            Entry_Item jugador.Apellido
            Set piColumnSpan to 6
            Set piColumnIndex to 6
            Set peLabelPosition to lpTop
            Set psLabel to "Apellido"
            Set psCSSClass to "CampoBlanco"
        End_Object 

        Object oequipoNombre is a cWebForm
            Entry_Item equipo.Nombre
            Set piColumnSpan to 6
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Equipo"
            Set psCSSClass to "CampoBlanco"
            Set pbPromptButton to True

            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnPrompt
                Send NavigatePath
            End_Procedure
        End_Object

        Object ojugadorNacionalidad is a cWebForm
            Entry_Item jugador.Nacionalidad
            Set piColumnSpan to 6
            Set piColumnIndex to 6
            Set peLabelPosition to lpTop
            Set psLabel to "Nacionalidad"
            Set psCSSClass to "CampoBlanco"
        End_Object

        Object oposicionNombre is a cWebForm
            Set piColumnSpan to 6
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Posición"
            Set psCSSClass to "CampoBlanco"
            Set pbReadOnly to True
        End_Object

        // =========================================================================
        // RESPUESTA SPRINT 2 - TAREA UNDEFINED:
        // Zoom jugador -> Select posición: ¿Hay relación entre ellas?
        //
        // En el modelo de esta aplicación, la conexión entre 'jugador' y 'posicion'
        // se articula mediante la tabla intermedia 'jugadorposicion'
        // (ojugadorposicion_DD), aunque en el dominio del fútbol un jugador
        // pueda considerarse asignado a una posición concreta (portero, defensa,
        // mediocentro, delantero, etc.).
        //
        // En el marco DrillDown de DataFlex, el salto desde ZoomJugador hacia
        // SelectPosicion se clasifica como 'Undefined' porque no es una relación
        // jerárquica directa Padre->Hijo (nfFromParent) ni Hijo->Padre (nfFromChild)
        // entre las vistas de detalle y selección, sino que pasa por la entidad
        // intermedia / consulta de posiciones.
        // =========================================================================
        
    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object 
    End_Object 

    Function PosicionActualJugador Returns String
        Boolean bHasRecord bFound
        Integer iJugadorID
        String sPosicion

        Move "" to sPosicion
        Get HasRecord of ojugador_DD to bHasRecord
        Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorID

        If (iJugadorID <= 0) Begin
            Move jugador.ID to iJugadorID
        End

        If (not(bHasRecord) and iJugadorID <= 0) Begin
            Function_Return ""
        End

        Clear jugadorposicion
        Find ge jugadorposicion by Index.1
        Move (Found) to bFound

        While (bFound)
            If (jugadorposicion.JugadorID = iJugadorID) Begin
                Clear posicion
                Move jugadorposicion.PosicionID to posicion.ID
                Find eq posicion by Index.1
                If (Found) Begin
                    If (sPosicion = "") Begin
                        Move (Trim(posicion.Nombre)) to sPosicion
                    End
                    Else Begin
                        Move (sPosicion + ", " + Trim(posicion.Nombre)) to sPosicion
                    End
                End
            End

            Find gt jugadorposicion by Index.1
            Move (Found) to bFound
        Loop

        Function_Return sPosicion
    End_Function

    Procedure UpdatePosicionJugador
        String sPosicion
        Get PosicionActualJugador to sPosicion
        WebSet psValue of oposicionNombre to sPosicion
    End_Procedure

    Function WebCrumb_Caption Returns String
        Boolean bHasRecord
        String sNombre sApellido

        Get HasRecord of ojugador_DD to bHasRecord

        If (bHasRecord or jugador.ID > 0) Begin
            Get Field_Current_Value of ojugador_DD Field jugador.Nombre to sNombre
            Move (Trim(sNombre)) to sNombre

            If (sNombre = "") Begin
                Move (Trim(jugador.Nombre)) to sNombre
            End

            Get Field_Current_Value of ojugador_DD Field jugador.Apellido to sApellido
            Move (Trim(sApellido)) to sApellido

            If (sApellido = "") Begin
                Move (Trim(jugador.Apellido)) to sApellido
            End

            If (sNombre <> "" and sApellido <> "") Begin
                Function_Return ("Jugador: " + sNombre + " " + sApellido)
            End
            Else If (sNombre <> "") Begin
                Function_Return ("Jugador: " + sNombre)
            End
            Else Begin
                Function_Return "Jugador"
            End
        End

        Function_Return "Nuevo jugador"
    End_Function

    Function NavigateCaption Returns String
        String sCaption
        Get WebCrumb_Caption to sCaption
        Function_Return sCaption
    End_Function

    Function GetBreadcrumbCaption Returns String
        String sCaption
        Get WebCrumb_Caption to sCaption
        Function_Return sCaption
    End_Function

    Procedure UpdateViewCaption
        String sCaption
        Get WebCrumb_Caption to sCaption
        WebSet psCaption to sCaption
    End_Procedure

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnShow
        Forward Send OnShow
        Send UpdateViewCaption
        Send UpdatePosicionJugador
    End_Procedure

    Procedure OnLoad
        Forward Send OnLoad
        Send UpdateViewCaption
        Send UpdatePosicionJugador
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject

        Case Begin
            Case (NavigateData.eNavigateType = nfFromMain)
                Case Break

            Case (NavigateData.eNavigateType = nfFromParent)
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                Case Break

            Case Else
        Case End

        Send SetActionButtons
        Send UpdateViewCaption
        Send UpdatePosicionJugador
    End_Procedure

End_Object